# Local configuration for chora-sharing.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_GRPC_PORT=9090

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
# Unset → in-memory repositories (not durable).
POSTGRES_DB=chora_sharing
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@localhost:5432/chora_sharing?sslmode=disable
CHORA_OUTBOX_DSN=postgres://chora:chora@localhost:5432/chora_sharing?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-sharing-local

# Event bus — NATS JetStream. Unset disables the bus (in-memory fallback).
NATS_URL=nats://127.0.0.1:4222
CHORA_SOURCE_PROJECT=chora-local

# Identity gRPC (display_name resolution + royalty mana debit).
SVC_IDENTITY_GRPC_URL=

# ADK agent crews (GKE web-mode endpoints). Unset → the corresponding
# feature degrades (profile generate 501s, matchmaking uses the
# projection-based selector, moderation engine gate skipped).
MODERATION_ENGINE_GKE_ENDPOINT=
PROFILE_CONJURER_GKE_ENDPOINT=
DUEL_ATOM_SMITH_GKE_ENDPOINT=

# Event-push inbox bearer verification. Unset → verification disabled
# (the mesh / network layer is the enforcing gate).
CHORA_PUBSUB_PUSH_AUDIENCE_BASE=

# Config file overrides (defaults resolve inside the repo / image).
CHORA_FAMILIAR_TEMPLATES_PATH=
CHORA_PII_CLOSURE_MAP_PATH=
CHORA_AGENT_GUARDRAIL_MAPPING=

# Royalty accounting (defaults: reputation / atom_royalty).
CHORA_SHARING_ROYALTY_CURRENCY=
CHORA_SHARING_MANA_ACTION_CODE=

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset degrades to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Integration tests (build-tagged `integration`) — real PostgreSQL DSN.
# CHORA_TEST_DSN=postgres://chora:chora@localhost:5432/chora_sharing?sslmode=disable
